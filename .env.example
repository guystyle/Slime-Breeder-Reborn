# --- Production (Vercel): Turso database -------------------------------------------------
# turso db create slime-breeder ; turso db show slime-breeder --url ; turso db tokens create slime-breeder
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=

# Protects /api/cron/purge (Vercel Cron sends it automatically). Any long random string.
CRON_SECRET=

# --- Local / self-hosting -------------------------------------------------------------------
# Used only when TURSO_DATABASE_URL is not set.
# SLIME_DB=slime.db
# Minutes between plays per account (default 3, 0 = no waiting)
# SLIME_COOLDOWN_MIN=0
# PORT=3000
